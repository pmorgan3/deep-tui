{
  "name": "@flect/cli",
  "version": "0.0.0",
  "description": "Plugin-first agent harness CLI microkernel.",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22.0.0" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "flect": "./dist/bin.js"
